{
  // The sites zone's own page. scripts/deploy-sites-web.sh writes wrangler.jsonc from this file with
  // the zone filled in (CASAMA_SITES_ZONE). Only the bare zone and www: every other name on the zone
  // is a site, routed by the wildcard record to the casama-sites tunnel.
  "name": "casama-sites-site",
  "compatibility_date": "2026-11-01",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "{{ZONE}}", "custom_domain": true },
    { "pattern": "www.{{ZONE}}", "custom_domain": true }
  ],
  "workers_dev": false
}
