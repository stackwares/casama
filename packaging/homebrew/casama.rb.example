class Casama < Formula
  desc "Command-line client for Casama, the self-hostable home for AI bots with computers"
  homepage "https://github.com/stackwares/casama"
  version "0.6.0"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/stackwares/casama/releases/download/cli-v0.6.0/casama-0.6.0-darwin-arm64.tar.gz"
      sha256 "5b8af8a7d90ae85dbb0bf868e4a0e9c80341d08af25ad567298e83abcd603bf5"
    end
    on_intel do
      url "https://github.com/stackwares/casama/releases/download/cli-v0.6.0/casama-0.6.0-darwin-x64.tar.gz"
      sha256 "0000"
    end
  end
  on_linux do
    on_arm do
      url "https://github.com/stackwares/casama/releases/download/cli-v0.6.0/casama-0.6.0-linux-arm64.tar.gz"
      sha256 "0000"
    end
    on_intel do
      url "https://github.com/stackwares/casama/releases/download/cli-v0.6.0/casama-0.6.0-linux-x64.tar.gz"
      sha256 "0000"
    end
  end

  def install
    bin.install "casama"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/casama --version")
  end
end
