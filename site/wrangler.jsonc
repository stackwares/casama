{
  "name": "casama-site",
  "compatibility_date": "2026-11-01",
  "main": "gallery-link.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/gallery", "/gallery/*"]
  },
  "routes": [
    { "pattern": "casama.ai", "custom_domain": true },
    { "pattern": "www.casama.ai", "custom_domain": true }
  ],
  "workers_dev": false
}
