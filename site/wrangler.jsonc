{
  "name": "casama-site",
  "compatibility_date": "2026-11-01",
  "main": "gallery-link.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/gallery", "/gallery/*", "/i/*", "/open", "/open/*", "/get", "/get/*", "/b", "/assets/film/*", "/newsletter/*"]
  },
  "routes": [
    { "pattern": "casama.ai", "custom_domain": true },
    { "pattern": "www.casama.ai", "custom_domain": true }
  ],
  // Page-view counts by source (docs/SEO-PLAN.md §10.5): no cookies or visitor IDs.
  "analytics_engine_datasets": [{ "binding": "VISITS", "dataset": "casama_site_visits" }],
  // The monthly email's sign-up (D-404, newsletter.js): a few tries a minute per IP and per address.
  "ratelimits": [{ "name": "NEWSLETTER_LIMIT", "namespace_id": "4031", "simple": { "limit": 5, "period": 60 } }],
  "workers_dev": false
}
