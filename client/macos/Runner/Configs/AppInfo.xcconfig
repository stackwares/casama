// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = casama_app

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = ai.casama.app

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Casama. All rights reserved.

// Debug builds are signed ad hoc with DebugProfile.entitlements, which needs no Apple account.
// A Signing.local.xcconfig next to this file (gitignored; copy Signing.local.xcconfig.example)
// signs them with an Apple Development certificate and the "Casama Mac Development" profile
// instead, which turns on Apple's own Sign in with Apple sheet, Google's sheet and passkeys.
CASAMA_DEBUG_ENTITLEMENTS = Runner/DebugProfile.entitlements
CASAMA_DEBUG_SIGN_STYLE = Automatic
CASAMA_DEBUG_PROFILE =
#include? "Signing.local.xcconfig"
