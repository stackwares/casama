<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac widget extension (D-405 §8.8), signed with a provisioning profile: sandboxed (macOS
     loads no widget from an extension that isn't), the network to fetch the glance, the
     Team-ID-named app group the app writes the glance to, and the keychain group that holds the
     widget key. The packaging scripts expand the $(…) prefixes, which codesign leaves alone. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>V8V5US964Z.ai.casama.app</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)ai.casama.app.widgets</string>
	</array>
</dict>
</plist>
