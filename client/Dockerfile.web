# The Flutter web app for the self-host stack (compose profile `web`). The build points the app at
# the server that serves the page (empty KASAMA_API_URL means "this origin"); users can still pick
# another server at sign-in. Build from the repo root:
#   docker build -f client/Dockerfile.web -t kasama/web:local .
# Flutter is installed from Google's release archive (pinned version and checksum), so the build
# doesn't depend on a third-party Flutter image.
FROM debian:bookworm-slim AS build
ARG FLUTTER_VERSION=3.47.9
ARG FLUTTER_SHA256=25ed8c3c29d51a7353f2a944310b478af8214920639524b19c50a19e6c044c5a
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git unzip xz-utils \
  && rm -rf /var/lib/apt/lists/* \
  && curl -fsSL -o /tmp/flutter.tar.xz "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
  && echo "${FLUTTER_SHA256}  /tmp/flutter.tar.xz" | sha256sum -c - \
  && tar -xJf /tmp/flutter.tar.xz -C /opt && rm /tmp/flutter.tar.xz \
  && git config --global --add safe.directory /opt/flutter
ENV PATH=/opt/flutter/bin:$PATH
RUN flutter config --no-analytics --enable-web && flutter precache --web
WORKDIR /src
COPY dart dart
COPY client client
WORKDIR /src/client
RUN flutter pub get && flutter build web --release --dart-define=KASAMA_API_URL=

FROM caddy:2.10.2-alpine
COPY --from=build /src/client/build/web /srv
RUN printf ':80 {\n\troot * /srv\n\ttry_files {path} /index.html\n\tfile_server\n\theader Content-Security-Policy "default-src '"'"'self'"'"'; script-src '"'"'self'"'"' '"'"'wasm-unsafe-eval'"'"'; style-src '"'"'self'"'"' '"'"'unsafe-inline'"'"'; img-src '"'"'self'"'"' data: blob: https:; connect-src '"'"'self'"'"' wss: https:; font-src '"'"'self'"'"' data:; media-src '"'"'self'"'"' blob:; frame-ancestors '"'"'none'"'"'"\n}\n' > /etc/caddy/Caddyfile
