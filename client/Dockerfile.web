# The Flutter web app for the self-host stack (compose profile `web`). The build points the app at
# the server that serves the page (empty CASAMA_API_URL means "this origin"); users can still pick
# another server at sign-in. Build from the repo root:
#   docker build -f client/Dockerfile.web -t casama/web:local .
# Flutter comes from the official repository at the pinned release tag, checked against its commit
# (so a moved tag fails the build). Cloning works on x64 and arm64 hosts alike: the Linux release
# archive is x64-only. No third-party Flutter image.
FROM debian:bookworm-slim AS build
ARG FLUTTER_VERSION=3.47.9
ARG FLUTTER_COMMIT=c197ca5199e9ee5661e865596c9c07294dfab51c
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git unzip xz-utils \
  && rm -rf /var/lib/apt/lists/* \
  && git clone --depth 1 --branch "${FLUTTER_VERSION}" https://github.com/flutter/flutter.git /opt/flutter \
  && test "$(git -C /opt/flutter rev-parse HEAD)" = "${FLUTTER_COMMIT}" \
  && git config --global --add safe.directory /opt/flutter
ENV PATH=/opt/flutter/bin:$PATH
RUN flutter config --no-analytics --enable-web && flutter precache --web
WORKDIR /src
# scripts/build-web.sh is the only release web compile, and it requires Wasm (D-196).
COPY scripts/build-web.sh scripts/build-web.sh
COPY dart dart
COPY client client
WORKDIR /src/client
RUN bash /src/scripts/build-web.sh --dart-define=CASAMA_API_URL=

FROM caddy:2.10.2-alpine
COPY --from=build /src/client/build/web /srv
RUN printf ':80 {\n\troot * /srv\n\ttry_files {path} /index.html\n\tfile_server\n\theader Cross-Origin-Opener-Policy "same-origin"\n\theader Cross-Origin-Embedder-Policy "credentialless"\n\theader Content-Security-Policy "default-src '\''self'\''; script-src '\''self'\'' '\''wasm-unsafe-eval'\'' https://www.gstatic.com https://us-assets.i.posthog.com; worker-src '\''self'\'' blob:; style-src '\''self'\'' '\''unsafe-inline'\''; img-src '\''self'\'' data: blob: https:; connect-src '\''self'\'' wss: https:; font-src '\''self'\'' data:; media-src '\''self'\'' blob:; frame-ancestors '\''none'\''"\n}\n' > /etc/caddy/Caddyfile
