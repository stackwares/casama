<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- No advertising id (D-397): firebase_analytics would otherwise merge this permission in. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Device connections (D-149): only asked when the person turns a kind on. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Device triggers (D-151): named places and leave-now, asked only when Places is turned on. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Live calls keep the mic in the background (D-327): CallService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Health data (D-150): read-only, asked only when Health is turned on. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_MENSTRUATION" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Live Updates (Android 16, D-324): a running bot as a promoted notification with a chip. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <application
        android:label="Casama"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- mobile_scanner uses ML Kit from Play services (gradle.properties); fetch the barcode
             model at install so the first scan doesn't wait for a download. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode" />
        <!-- Status-bar icon for FCM notifications: the white mascot silhouette, not the launcher
             icon (its background turns into a white square). Source: android/notification_icon.svg. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <!-- Health Connect shows the privacy policy from here (D-150). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep links (casama://quick-ask, widget and notification links) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="casama.ai" android:pathPrefix="/gallery/" />
                <data android:scheme="https" android:host="casama.ai" android:pathPrefix="/i/" />
                <!-- Links in emails and invites (D-326): casama.ai/open/<route> opens <route> -->
                <data android:scheme="https" android:host="casama.ai" android:pathPrefix="/open/" />
                <!-- A sign-in QR code read by the phone's camera (D-296) -->
                <data android:scheme="https" android:host="casama.ai" android:path="/pair" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="casama" />
            </intent-filter>
            <!-- Share to bot -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- The end of a sign-in in the sign-in sheet (a Custom Tab, D-243): the server sends the
             browser to casama-auth://done and this activity closes the tab. Its own scheme, so it
             never takes casama:// deep links from MainActivity. -->
        <activity
            android:name=".SignInCallbackActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="casama-auth" />
            </intent-filter>
        </activity>
        <!-- Suggestion pushes with Do it / Not now (D-247): drawn from data-only FCM messages. -->
        <receiver
            android:name=".SuggestionPushReceiver"
            android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter>
                <action android:name="com.google.android.c2dm.intent.RECEIVE" />
            </intent-filter>
        </receiver>
        <receiver android:name=".SuggestionDismissReceiver" android:exported="false" />
        <activity
            android:name=".SuggestionActionActivity"
            android:exported="false"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- A running bot as a live notification (D-324, Phase 5): server updates arrive as
             data-only FCM messages of kind "live", drawn here while the app isn't running. -->
        <receiver
            android:name=".LiveRunReceiver"
            android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter>
                <action android:name="com.google.android.c2dm.intent.RECEIVE" />
            </intent-filter>
        </receiver>
        <receiver android:name=".LiveRunDismissReceiver" android:exported="false" />
        <activity
            android:name=".LiveRunActionActivity"
            android:exported="false"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Widgets (D-405, docs/WIDGETS-PLAN.md §6.4): RemoteViews drawn from the glance the app
             (or GlanceRefresh) writes. BotStatusWidget keeps its name so placed widgets carry over. -->
        <receiver android:name=".NeedsYouWidget" android:exported="true" android:label="@string/widget_needs_you">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/needs_you_widget_info" />
        </receiver>
        <receiver android:name=".BotStatusWidget" android:exported="true" android:label="@string/widget_bot">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/bot_status_widget_info" />
        </receiver>
        <receiver android:name=".AskWidget" android:exported="true" android:label="@string/widget_ask">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/ask_widget_info" />
        </receiver>
        <receiver android:name=".RoutinesWidget" android:exported="true" android:label="@string/widget_routines">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/routines_widget_info" />
        </receiver>
        <receiver android:name=".TodayWidget" android:exported="true" android:label="@string/widget_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/today_widget_info" />
        </receiver>
        <receiver android:name=".BriefWidget" android:exported="true" android:label="@string/widget_brief">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/brief_widget_info" />
        </receiver>
        <receiver android:name=".LibraryWidget" android:exported="true" android:label="@string/widget_library">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/library_widget_info" />
        </receiver>
        <receiver android:name=".TasksWidget" android:exported="true" android:label="@string/widget_tasks">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/tasks_widget_info" />
        </receiver>
        <receiver android:name=".CreditsWidget" android:exported="true" android:label="@string/widget_credits">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/credits_widget_info" />
        </receiver>
        <!-- Today's list below Android 12, where a collection's items come from a service. -->
        <service
            android:name=".TodayWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <!-- The widget picker for Ask, Bot and Routines (a bot, or routines): native, no Flutter. -->
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/WidgetConfigTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- Widget refresh pushes (D-405 Phase 3): data-only FCM messages of kind "glance", with no
             content; they queue a fetch with the widget key (GlanceRefresh). -->
        <receiver
            android:name=".GlancePushReceiver"
            android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter>
                <action android:name="com.google.android.c2dm.intent.RECEIVE" />
            </intent-filter>
        </receiver>
        <!-- Quick Settings tile "Ask Casama" (D-405 §6.4). -->
        <service
            android:name=".AskTileService"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_ask"
            android:label="@string/tile_ask"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- PostHog stays off until Dart calls setup() with a build-time key (D-063). -->
        <meta-data
            android:name="com.posthog.posthog.AUTO_INIT"
            android:value="false" />
        <meta-data
            android:name="com.posthog.posthog.CAPTURE_PUSH_NOTIFICATION_OPENED"
            android:value="false" />
        <!-- Google Analytics (GA4) stays off until Dart turns it on for Casama Cloud with consent (D-397). No ad id. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <!-- Device triggers (D-151): geofences for named places, re-registered after a reboot. -->
        <receiver android:name="com.chunkytofustudios.native_geofence.receivers.NativeGeofenceBroadcastReceiver" android:exported="true" />
        <receiver android:name="com.chunkytofustudios.native_geofence.receivers.NativeGeofenceRebootBroadcastReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service android:name=".CallService" android:foregroundServiceType="microphone" android:exported="false" />
        <service android:name="com.chunkytofustudios.native_geofence.NativeGeofenceForegroundService" android:foregroundServiceType="location" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <!-- Notifications from apps the person picks (D-151). -->
        <service android:label="Casama" android:name="notification.listener.service.NotificationListener" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Wear OS (D-410): the Casama watch app's messages on /casama/watch (sign in, open). -->
        <service
            android:name=".WearBridgeService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/casama/watch" />
            </intent-filter>
        </service>
        <!-- Android 14+: Health Connect's permission usage screen. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- speech_to_text: the device's own recognizer, the fallback for dictation. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
