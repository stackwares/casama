<?xml version="1.0" encoding="utf-8"?>
<!-- The Canvas widget with no canvas yet (docs/BOT-WIDGET-PLAN.md §6.5): the mascot, "Ask a bot to
     put something here" and one example. At 2×1 the code leaves out the mascot and the example. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">
    <ImageView
        android:id="@+id/w_mascot"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/mascot_winky" />
    <TextView
        android:id="@+id/w_title"
        style="@style/WidgetText.Strong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2" />
    <TextView
        android:id="@+id/w_line"
        style="@style/WidgetText.Second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="2" />
</LinearLayout>
