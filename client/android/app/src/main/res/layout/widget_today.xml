<?xml version="1.0" encoding="utf-8"?>
<!-- Today (4×3 and taller): the date and a credits ring; the running bot with its timer and Stop
     when one runs; a scrolling list of Needs you, Up next and Lately; and an ask field. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_eyebrow"
                style="@style/WidgetText.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/w_title"
                style="@style/WidgetText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="17sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/w_asof"
            style="@style/WidgetText.AsOf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp" />
        <FrameLayout
            android:id="@+id/w_ring_box"
            android:layout_width="40dp"
            android:layout_height="40dp">
            <ImageView
                android:id="@+id/w_ring_track"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:tint="@color/widget_track" />
            <ImageView
                android:id="@+id/w_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:tint="@color/widget_primary" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_live"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_pill_green"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/w_live_mark"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_live_bot"
                style="@style/WidgetText.Strong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_on_green" />
            <TextView
                android:id="@+id/w_live_step"
                style="@style/WidgetText.Second"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_on_green" />
        </LinearLayout>
        <Chronometer
            android:id="@+id/w_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/widget_on_green"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/w_live_stop"
            style="@style/WidgetButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <ListView
        android:id="@+id/w_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />
    <TextView
        android:id="@+id/w_empty"
        style="@style/WidgetText.Second"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:maxLines="2"
        android:textSize="13sp"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_field"
            style="@style/WidgetText"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/widget_field"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/widget_fg2"
            android:textSize="14sp" />
        <ImageView
            android:id="@+id/w_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_fab"
            android:contentDescription="Talk"
            android:padding="10dp"
            android:src="@drawable/ic_widget_mic" />
    </LinearLayout>
</LinearLayout>
