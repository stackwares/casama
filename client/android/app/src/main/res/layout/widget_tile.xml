<?xml version="1.0" encoding="utf-8"?>
<!-- The 2×2 shape that Needs you, Bot and Routines share: a top row (a count or a small heading,
     a state pill, the bot's face), then a title, one or two lines, and at most two capsule
     buttons. The widget's code hides what it doesn't use. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_lead_mark"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />
        <TextView
            android:id="@+id/w_count"
            style="@style/WidgetText.Big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_orange"
            android:visibility="gone" />
        <TextView
            android:id="@+id/w_eyebrow"
            style="@style/WidgetText.Eyebrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone" />
        <FrameLayout
            android:id="@+id/w_spacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <LinearLayout
            android:id="@+id/w_pill"
            style="@style/WidgetPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/w_pill_text"
                style="@style/WidgetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_on_green"
                android:textSize="11.5sp" />
            <Chronometer
                android:id="@+id/w_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:textColor="@color/widget_on_green"
                android:textSize="11.5sp"
                android:visibility="gone" />
        </LinearLayout>
        <ImageView
            android:id="@+id/w_mark"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView
        android:id="@+id/w_title"
        style="@style/WidgetText.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp" />
    <TextView
        android:id="@+id/w_line"
        style="@style/WidgetText.Second"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="2"
        android:textSize="12.5sp" />
    <LinearLayout
        android:id="@+id/w_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/w_btn1"
            style="@style/WidgetButton.Fill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/w_btn2"
            style="@style/WidgetButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/w_asof"
        style="@style/WidgetText.AsOf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />
</LinearLayout>
