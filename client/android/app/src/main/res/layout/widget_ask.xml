<?xml version="1.0" encoding="utf-8"?>
<!-- Ask, 2×2: the bot's face, the microphone, "Ask <bot>" and two things to try (the person's own
     starters, D-338). A starter opens quick ask with it typed in, not sent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_mark"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/mascot_winky" />
        <TextView
            android:id="@+id/w_title"
            style="@style/WidgetText.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Ask Milo" />
        <ImageView
            android:id="@+id/w_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_fab"
            android:contentDescription="Talk"
            android:padding="10dp"
            android:src="@drawable/ic_widget_mic" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView
        android:id="@+id/w_chip1"
        style="@style/WidgetText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_field"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:text="☀️ Plan my day" />
    <TextView
        android:id="@+id/w_chip2"
        style="@style/WidgetText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_field"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:text="✉️ What's new in my inbox?" />
</LinearLayout>
