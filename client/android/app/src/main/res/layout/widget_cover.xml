<?xml version="1.0" encoding="utf-8"?>
<!-- Library, 2×2: the latest creation by its cover (or a tile in its kind's colour), its title and
     the bot that made it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <ImageView
        android:id="@+id/w_cover"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />
    <TextView
        android:id="@+id/w_title"
        style="@style/WidgetText.Strong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />
    <TextView
        android:id="@+id/w_line"
        style="@style/WidgetText.Second"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />
</LinearLayout>
