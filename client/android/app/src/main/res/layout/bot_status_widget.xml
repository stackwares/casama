<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:drawable/dialog_holo_light_frame"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView android:id="@+id/widget_bot" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textStyle="bold" android:textSize="16sp" android:text="Casama" />
    <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="13sp" android:text="" />
    <TextView android:id="@+id/widget_cost" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:text="" />
    <Button android:id="@+id/widget_ask" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Ask" />
</LinearLayout>
