<?xml version="1.0" encoding="utf-8"?>
<!-- The 4×2 shape that Needs you, Routines, Brief, Library and Tasks share: a heading (with a
     count badge or the bot's face), then rows the code adds (widget_row.xml and friends), a body
     text, or one quiet line when there is nothing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_mark"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />
        <TextView
            android:id="@+id/w_title"
            style="@style/WidgetText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/w_badge"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_badge"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:minWidth="22dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/w_eyebrow"
            style="@style/WidgetText.Second"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/w_asof"
            style="@style/WidgetText.AsOf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />
    <TextView
        android:id="@+id/w_body"
        style="@style/WidgetText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top"
        android:lineSpacingExtra="2dp"
        android:maxLines="4"
        android:visibility="gone" />
    <TextView
        android:id="@+id/w_empty"
        style="@style/WidgetText.Second"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:maxLines="2"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
