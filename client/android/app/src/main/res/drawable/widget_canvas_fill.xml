<?xml version="1.0" encoding="utf-8"?>
<!-- The Canvas widget's colour background: white in the widget's own corners, tinted in code to the
     bot's colour (an ImageView's colour filter, which RemoteViews can set on every version). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
