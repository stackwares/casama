{
  "name": "secrets",
  "turns": [
    {
      "when": {
        "systemIncludes": "extract lasting memories"
      },
      "events": [
        {
          "type": "text",
          "text": "{\"memories\":[]}"
        },
        {
          "type": "finish",
          "usage": {
            "inputTokens": 50,
            "outputTokens": 5
          },
          "finishReason": "stop",
          "model": ""
        }
      ]
    },
    {
      "when": {
        "lastRole": "user",
        "lastUserIncludes": "sign in with a code"
      },
      "events": [
        {
          "type": "tool_call",
          "call": {
            "callId": "k3",
            "name": "secrets__request",
            "args": {
              "name": "ACME_2FA",
              "service": "Acme",
              "allowed_hosts": [
                "login.acme.example"
              ],
              "reason": "Acme asks for a code.",
              "kind": "totp"
            }
          }
        },
        {
          "type": "finish",
          "usage": {
            "inputTokens": 100,
            "outputTokens": 10
          },
          "finishReason": "tool-calls",
          "model": ""
        }
      ]
    },
    {
      "when": {
        "lastRole": "user",
        "lastUserIncludes": "charge the customer"
      },
      "events": [
        {
          "type": "tool_call",
          "call": {
            "callId": "k1",
            "name": "secrets__request",
            "args": {
              "name": "STRIPE_API_KEY",
              "service": "Stripe",
              "allowed_hosts": [
                "api.stripe.com"
              ],
              "reason": "To create the charge."
            }
          }
        },
        {
          "type": "finish",
          "usage": {
            "inputTokens": 100,
            "outputTokens": 10
          },
          "finishReason": "tool-calls",
          "model": ""
        }
      ]
    },
    {
      "when": {
        "lastRole": "user",
        "lastUserIncludes": "two services"
      },
      "events": [
        {
          "type": "tool_call",
          "call": {
            "callId": "k2",
            "name": "secrets__request",
            "args": {
              "name": "MIXED_KEY",
              "service": "Mixed",
              "allowed_hosts": [
                "api.stripe.com",
                "evil.example"
              ],
              "reason": "x"
            }
          }
        },
        {
          "type": "finish",
          "usage": {
            "inputTokens": 100,
            "outputTokens": 10
          },
          "finishReason": "tool-calls",
          "model": ""
        }
      ]
    },
    {
      "when": {
        "lastRole": "tool",
        "lastToolName": "secrets.request"
      },
      "events": [
        {
          "type": "text",
          "text": "Thanks, continuing."
        },
        {
          "type": "finish",
          "usage": {
            "inputTokens": 100,
            "outputTokens": 10
          },
          "finishReason": "stop",
          "model": ""
        }
      ]
    }
  ]
}