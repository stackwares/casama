        { "type": "text", "text": "{\"memories\":[]}" },
        { "type": "finish", "usage": { "inputTokens": 50, "outputTokens": 5 }, "finishReason": "stop", "model": "" }
      ]
    },
    {
      "when": { "lastRole": "user", "lastUserIncludes": "train tickets" },
