        "systemIncludes": "workspace/bots/researcher"
      },
      "events": [
        {
          "type": "tool_call",
          "call": {
            "callId": "w1",
            "name": "files.write",
            "args": {
              "path": "notes.md",
              "content": "hello"
            }
          }
        },
        {
          "type": "finish",
          "usage": {
            "inputTokens": 100,
            "outputTokens": 10
          },
          "finishReason": "stop",
          "model": ""
        }
      ]
    },
    {
      "when": {
        "lastRole": "tool",
        "lastToolName": "files.write"
      },
      "events": [
        {
          "type": "tool_call",
          "call": {
            "callId": "l1",
            "name": "files.list",
            "args": {
              "path": "shared"
            }
          }
        },
        {
          "type": "finish",
          "usage": {
            "inputTokens": 100,
            "outputTokens": 10
          },
          "finishReason": "stop",
          "model": ""
