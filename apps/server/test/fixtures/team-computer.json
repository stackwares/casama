{
  "name": "team-computer",
  "turns": [
    {
      "when": {
        "systemIncludes": "extract lasting memories"
      },
      "events": [
        {
          "type": "text",
          "text": "{\"memories\":[]}"
        },
        {
          "type": "finish",
          "usage": {
            "inputTokens": 100,
            "outputTokens": 10
          },
          "finishReason": "stop",
          "model": ""
        }
      ]
    },
    {
      "when": {
        "lastRole": "user",
