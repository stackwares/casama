        },
        {
          "type": "finish",
          "usage": {
            "inputTokens": 100,
            "outputTokens": 10
          },
          "finishReason": "stop",
          "model": ""
        }
      ]
    },
    {
      "when": {
        "lastRole": "user",
        "lastUserIncludes": "look at the screen"
