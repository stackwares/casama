      "version": 1,
      "updated": "2026-11-18",
      "document": {
        "focus": [
          {
            "id": "email_calendar",
            "label": "Email and calendar",
            "intro": "I can keep an eye on your calendar, draft replies, and tell you each morning what needs you.",
            "first_task": {
              "label": "What should I keep an eye on this week?",
              "placeholder": "A deadline, a meeting, a reply you're waiting for",
              "prefix": "Please keep an eye on this for me: "
            },
            "starters": [
              "executive-assistant"
            ],
            "apps": [
              "google_calendar",
              "gmail"
            ]
          },
          {
            "id": "work_projects",
            "label": "Work projects",
            "intro": "I can turn projects into tasks, keep them moving, and tell you when something needs a decision.",
            "first_task": {
              "label": "Tell me a project you're working on.",
              "placeholder": "Launch the new pricing page by Friday",
              "prefix": "Let's set up this project: "
            },
            "starters": [
              "project-manager"
            ],
            "apps": [
              "notion",
              "linear",
              "atlassian"
            ]
          },
          {
            "id": "coding",
            "label": "Coding",
            "intro": "I can work in your repositories on my computer: read code, fix issues and open pull requests for you to review.",
            "first_task": {
              "label": "Point me at a repo.",
              "placeholder": "https://github.com/you/your-repo",
              "prefix": "Please take a look at this repository and tell me what you'd improve first: "
            },
            "starters": [
              "software-engineer"
            ],
            "apps": [
              "github"
            ]
          },
          {
            "id": "research",
            "label": "Research",
            "intro": "I can dig into a topic, compare sources, and write it up as a report or a page you can share.",
            "first_task": {
              "label": "Give me a topic to research.",
              "placeholder": "The best CRM for a 5-person team",
              "prefix": "Please research this and write it up as a short report: "
            },
            "starters": [
              "researcher"
            ],
            "apps": []
          },
          {
            "id": "sales",
            "label": "Sales and customers",
            "intro": "I can research the people and companies you talk to, prepare for meetings, and keep your CRM tidy.",
            "first_task": {
              "label": "Who should I research first?",
              "placeholder": "A company or a person",
              "prefix": "Please research this for an upcoming conversation: "
            },
            "starters": [
              "sales-assistant"
            ],
            "apps": [
              "hubspot",
              "google_calendar"
            ]
          },
          {
            "id": "errands",
            "label": "Personal errands",
            "intro": "I can take small things off your plate: bookings, reminders, comparisons and forms.",
            "first_task": {
              "label": "What's one errand I can take off your plate?",
              "placeholder": "Find a dentist near me who takes my insurance",
              "prefix": "Please help me with this errand: "
            },
            "starters": [
              "personal-assistant"
            ],
            "apps": [
              "google_calendar"
            ]
          },
          {
            "id": "health",
            "label": "Health and habits",
            "intro": "I can keep track of your sleep, activity and workouts from your phone, notice how they compare with your usual, and help you build habits. I'm not a doctor and won't give medical advice.",
            "first_task": {
              "label": "What habit would you like to build?",
              "placeholder": "Sleep before 11 on weeknights",
