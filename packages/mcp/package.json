{
  "name": "@casama/mcp",
  "version": "0.8.0",
  "description": "Casama MCP server: control your Casama bots from AI coding tools (Claude Code, Cursor, Codex, and others).",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://docs.casama.ai/guide/mcp",
  "bugs": {
    "email": "support@casama.ai"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "casama",
    "ai-agents",
    "claude-code",
    "cursor"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "casama-mcp": "./src/main.ts"
  },
  "exports": {
    ".": "./src/server.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/main.js",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "casama-mcp": "./dist/main.js"
    },
    "exports": {
      ".": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    }
  }
}
