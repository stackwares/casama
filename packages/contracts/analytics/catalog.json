{
  "version": 1,
  "notes": "Source of truth for product analytics events (ANALYTICS-PLAN \u00a76). Names are permanent. `pnpm gen` writes client/lib/core/analytics_events.g.dart from this file; packages/contracts/test/analytics-catalog.test.ts checks it against the code.",
  "forbidden_property_words": [
    "message",
    "text",
    "content",
    "token",
    "input",
    "output",
    "body",
    "args",
    "prompt",
    "email",
    "persona",
    "secret",
    "password",
    "credential",
    "cookie",
    "authorization",
    "name",
    "title",
    "url",
    "phone",
    "query"
  ],
  "super_properties": ["app", "environment", "platform", "distribution", "server_kind", "source"],
  "events": [
    {
      "name": "sign_in_started",
      "by": ["client"],
      "description": "A sign-in method was started.",
      "properties": {
        "method": {
          "type": "string",
          "values": [
            "password",
            "email_code",
            "apple",
            "google",
            "passkey",
            "sso",
            "desktop_browser"
          ]
        },
        "surface": {
          "type": "string",
          "values": ["sign_in"]
        },
        "is_sign_up": {
          "type": "boolean"
        }
      },
      "funnels": ["F1"]
    },
    {
      "name": "sign_in_failed",
      "by": ["client"],
      "description": "A password or code sign-in did not work.",
      "properties": {
        "method": {
          "type": "string",
          "values": ["password", "email_code"]
        },
        "is_sign_up": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "values": ["rejected", "invalid_code"]
        }
      },
      "funnels": ["F1"]
    },
    {
      "name": "sign_in_completed",
      "by": ["client"],
      "description": "Signed out then in on this device (not a cold start with a saved session).",
