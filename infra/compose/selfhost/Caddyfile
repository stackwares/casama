# One public address for everything: the Kasama API and the Supabase gateway (Auth, REST,
# Realtime), plus the web app when the `web` profile is on. KASAMA_SITE is a domain (automatic
# HTTPS) or ":80" for plain HTTP behind another proxy or for local trials.
{$KASAMA_SITE} {
	encode zstd gzip
	@supabase path /auth/v1/* /rest/v1/* /realtime/v1/*
	handle @supabase {
		reverse_proxy kong:8000
	}
	@api path /v1/* /hooks/* /connect/* /telemetry/* /openapi.json /docs /docs/* /healthz /readyz /.well-known/apple-app-site-association /.well-known/assetlinks.json
	handle @api {
		reverse_proxy api:8787
	}
	handle {
		reverse_proxy web:80
	}
	# Without the web app (compose profile: web) the root answers with a short note.
	# Only the root page: health checks and API paths must see the real error (install.sh waits on /readyz).
	handle_errors 502 {
		# Invite links (D-167) open the API's join page when the web app isn't running.
		@join path /join/* /invites/*
		handle @join {
			rewrite /invites/* /join/{path.1}
			reverse_proxy api:8787
		}
		handle {
			@root path /
			respond @root "Kasama is running. Point the Kasama app or CLI at this address, or start the web app (compose profile: web)." 200
			respond "Kasama isn't ready yet (or this part isn't running)." 502
		}
	}
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

# Pages (D-119): bots' web pages on their own origin, so a page's scripts never share an origin
# with Kasama. KASAMA_PAGES_SITE is a domain of its own (pages.example.com, automatic HTTPS) or a
# port (":8790", the default) for local trials; set KASAMA_PAGES_URL to match.
{$KASAMA_PAGES_SITE} {
	encode zstd gzip
	reverse_proxy api:8790
}
