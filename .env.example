# Copy to .env. Values for local development come from `supabase status`.
MODE=api
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# Postgres (local Supabase default)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Optional legacy HS256 secret; when empty, tokens are verified against the project's JWKS.
SUPABASE_JWT_SECRET=

PUBLIC_APP_URL=http://localhost:3000
# App connections (D-089): OAuth clients for apps without automatic sign-up, JSON by app id.
# MCP_OAUTH_CLIENTS={"slack":{"client_id":"...","client_secret":"..."}}
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Where vendors send people back after an app sign-in. Default: <API>/oauth/callback, or localhost
# when the API is on a LAN address over http (vendors only accept https or localhost).
# OAUTH_REDIRECT_URL=http://localhost:8787/oauth/callback
# Casama Cloud abuse controls (D-094): auto = on when BILLING_ENABLED is on.
# ABUSE_CONTROLS=auto
# AUTH_HOOK_SECRET=v1,whsec_...
# APP_CHECK_PROJECT_NUMBER=
# ChatGPT plan sign-in (D-091): auto = on for self-hosted servers, off when BILLING_ENABLED is on.
# CHATGPT_SIGN_IN=auto
# Wallpaper photo search (optional, D-087). Unset: the app offers its own patterns and photos.
# UNSPLASH_ACCESS_KEY=
# Billing (Casama Cloud only, D-070). Self-hosted servers keep it off: no paywall, no limits.
BILLING_ENABLED=false
# DODO_API_KEY=
# DODO_WEBHOOK_SECRET=
# DODO_ENVIRONMENT=test
# APP_STORE_ISSUER_ID=
# APP_STORE_KEY_ID=
# APP_STORE_PRIVATE_KEY=/path/to/SubscriptionKey.p8
# APP_STORE_BUNDLE_ID=ai.casama.app
# APP_STORE_ENVIRONMENT=production
# GOOGLE_PLAY_PACKAGE_NAME=ai.casama.app
# GOOGLE_PLAY_SERVICE_ACCOUNT=/path/to/play-service-account.json
# GOOGLE_PLAY_RTDN_TOKEN=
# Cloud Connect, cloud side (D-071): forwarded to SUPERVISOR_URL and this model upstream.
# CLOUD_MODEL_UPSTREAM_URL=https://openrouter.ai/api/v1
# CLOUD_MODEL_UPSTREAM_KEY=
# CLOUD_MODEL_MARKUP=1
# CLOUD_COMPUTER_USD_PER_HOUR=0.05
# Cloud Connect, self-hosted side: run computers on Casama Cloud with a Cloud Connect key.
# CASAMA_CLOUD_URL=
# CASAMA_CLOUD_KEY=
RATE_LIMIT_PER_MINUTE=120

# Email (optional). Without it, invite tokens are returned to the inviter.
# Push notifications (worker): Firebase service account JSON, inline or a path to the file.
# The apps must be built with the same Firebase project (client/config/firebase.json).
FCM_SERVICE_ACCOUNT=
# Encryption at rest (workspaces turn it on in settings): a 32-byte base64 key that wraps workspace keys
# (openssl rand -base64 32). During a rotation, put the old key in CONTENT_ENCRYPTION_KEY_PREVIOUS.
CONTENT_ENCRYPTION_KEY=
# CONTENT_ENCRYPTION_KEY_PREVIOUS=
# Or AWS KMS instead: CONTENT_KMS_KEY_ID, CONTENT_KMS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# Sign-up allowlist: only these emails or domains can sign up (e.g. "ana@example.com,@acme.com").
# Needs the sign-up hook: SIGNUP_HOOK_ENABLED=true and AUTH_HOOK_SECRET=v1,whsec_<base64> (openssl rand -base64 32).
# SIGNUP_ALLOWED_EMAILS=
# SIGNUP_HOOK_ENABLED=false
# AUTH_HOOK_SECRET=
# Cloudflare AI Gateway for model calls (caching, logs, rate limits): https://gateway.ai.cloudflare.com/v1/<account>/<gateway>
# AI_GATEWAY_URL=
# AI_GATEWAY_TOKEN=
# Paid data resale (Casama Cloud only, after a written agreement with Treg). Self-hosters add their own Treg key in Model keys.
# TREG_API_KEY=
# TREG_RESALE=off
# iOS call rings through PushKit (phone-call voice): APNs token key (.p8 contents or a path), key id, team id
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
# APNS_VOIP_TOPIC=ai.casama.app.voip
RESEND_API_KEY=
EMAIL_FROM=Casama <no-reply@localhost>

# Observability (optional)
# Error reporting (D-063), off unless a key is set: auto | sentry | posthog | none
ERROR_REPORTING=auto
# Sentry protocol: sentry.io, self-hosted Sentry or GlitchTip
SENTRY_DSN=
# PostHog (cloud region or self-hosted)
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# Worker
RUN_CONCURRENCY=20
# auto = embed memories with the org's OpenAI key when present; none = full-text only
EMBEDDINGS=auto
# Replay recorded model responses instead of calling providers (tests, demos)
CASAMA_MODEL_FIXTURES=
# Record real model exchanges as fixture turns (JSON lines)
CASAMA_MODEL_RECORD=

# Integrations (Phase 4, optional until configured)
# COMPOSIO_API_KEY=
# PIPEDREAM_CLIENT_ID=
# PIPEDREAM_CLIENT_SECRET=
# PIPEDREAM_PROJECT_ID=
# PIPEDREAM_ENVIRONMENT=development
# MEDIA_GENERATION_PROVIDER=fal
# MEDIA_GENERATION_API_KEY=

# Computers (sandbox supervisor and egress proxy). Generate each with: openssl rand -hex 24
SUPERVISOR_URL=http://localhost:8788
SUPERVISOR_TOKEN=

# Live view (Phase 5): coturn's shared secret and the TURN address viewers use.
TURN_SECRET=
TURN_PUBLIC_HOST=localhost
TURN_PORT=3478
# TURN_TLS_PORT=5349
# PUBLIC_API_URL=https://api.example.com
# Pages (D-119) are served from their own origin. PAGES_PORT serves it from the API process.
# PAGES_URL=https://pages.example.com
# PAGES_PORT=8790
# Headless Chromium for page PDF export (unset: PDF export is off).
# PDF_CHROMIUM_PATH=/usr/bin/chromium

# Hosted computers (optional, supervisor): E2B and Daytona run the same computer image.
# E2B_API_KEY=
# E2B_TEMPLATE_HEADLESS=casama-computer-headless
# E2B_TEMPLATE_DESKTOP=casama-computer-desktop
# DAYTONA_API_KEY=
# DAYTONA_SNAPSHOT_HEADLESS=casama-computer-headless
# DAYTONA_SNAPSHOT_DESKTOP=casama-computer-desktop
# More hosted providers (D-139). Image-based ones run HOSTED_IMAGE_HEADLESS / HOSTED_IMAGE_DESKTOP.
# NOVITA_API_KEY=                      (E2B-compatible; templates like E2B)
# K8S_NAMESPACE=casama-computers       (in-cluster service account, or K8S_API_URL + K8S_TOKEN + K8S_CA_FILE)
# INCUS_URL=https://incus:8443         (INCUS_TOKEN, or INCUS_CLIENT_CERT_FILE + INCUS_CLIENT_KEY_FILE; INCUS_REGISTRY)
# BOAT_API_KEY=
# RAILWAY_TOKEN=  RAILWAY_PROJECT_ID=  RAILWAY_ENVIRONMENT_ID=  (RAILWAY_TOKEN_KIND=project for project tokens)
COMPUTER_TOKEN_SECRET=
EGRESS_CONTROL_TOKEN=

# Default model (D-064): Muse Ember on OpenRouter, GPT-6 Luna on OpenAI; medium reasoning effort unless overridden.
# DEFAULT_MODEL_OPENROUTER=meta/muse-ember
# DEFAULT_MODEL_OPENAI=gpt-6-luna
# DEFAULT_REASONING_EFFORT=medium
# Live checks (scripts/live-check.sh) read the real key from ~/.config/casama/openrouter.env,
# never from this file.

# Object storage for snapshots and checkpoints (supervisor, D-062). Default: filesystem volume.
# Self-hosted S3: `docker compose --profile s3 up`, then:
# OBJECT_STORE=s3
# S3_ENDPOINT=http://casama-s3:8333
# S3_BUCKET=casama
# S3_CREATE_BUCKET=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Hosted (recommended: Cloudflare R2, no egress fees):
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto

# Desktop companion (D-066): users' own machines as bot computers. On by default.
# LOCAL_COMPUTERS=true
# How the worker reaches the API's internal tunnel (default http://127.0.0.1:$PORT)
# API_INTERNAL_URL=http://api:8787

# Owner admin console (D-068): comma-separated owner emails; default: the first user to sign up.
# INSTANCE_ADMIN_EMAILS=you@example.com
# Update notices (off unless set), e.g. https://api.github.com/repos/stackwares/casama/releases/latest
# UPDATE_CHECK_URL=

# Phase 8 (D-072..D-078)
# Days between an account deletion request and the purge (0-30).
ACCOUNT_DELETION_GRACE_DAYS=7
# Opt-in anonymous telemetry: weekly instance id, version and two counts. Off by default.
TELEMETRY=off
# Bearer token for /metrics (Prometheus); without it /metrics is off in production.
METRICS_TOKEN=
# Enterprise features (ee/): license key and the Supabase service role key for SSO.
CASAMA_LICENSE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
