# Copy to .env. Values for local development come from `supabase status`.
MODE=api
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# Postgres (local Supabase default)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Optional legacy HS256 secret; when empty, tokens are verified against the project's JWKS.
SUPABASE_JWT_SECRET=

PUBLIC_APP_URL=http://localhost:3000
BILLING_ENABLED=false
RATE_LIMIT_PER_MINUTE=120

# Email (optional). Without it, invite tokens are returned to the inviter.
RESEND_API_KEY=
EMAIL_FROM=Kasama <no-reply@localhost>

# Observability (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Worker
RUN_CONCURRENCY=20
# auto = embed memories with the org's OpenAI key when present; none = full-text only
EMBEDDINGS=auto
# Replay recorded model responses instead of calling providers (tests, demos)
KASAMA_MODEL_FIXTURES=
# Record real model exchanges as fixture turns (JSON lines)
KASAMA_MODEL_RECORD=

# Integrations (Phase 4, optional until configured)
# COMPOSIO_API_KEY=
# PIPEDREAM_CLIENT_ID=
# PIPEDREAM_CLIENT_SECRET=
# PIPEDREAM_PROJECT_ID=
# PIPEDREAM_ENVIRONMENT=development
# MEDIA_GENERATION_PROVIDER=fal
# MEDIA_GENERATION_API_KEY=

# Computers (sandbox supervisor and egress proxy). Generate each with: openssl rand -hex 24
SUPERVISOR_URL=http://localhost:8788
SUPERVISOR_TOKEN=

# Live view (Phase 5): coturn's shared secret and the TURN address viewers use.
TURN_SECRET=
TURN_PUBLIC_HOST=localhost
TURN_PORT=3478
# TURN_TLS_PORT=5349
# PUBLIC_API_URL=https://api.example.com

# Hosted computers (optional, supervisor): E2B and Daytona run the same computer image.
# E2B_API_KEY=
# E2B_TEMPLATE_HEADLESS=kasama-computer-headless
# E2B_TEMPLATE_DESKTOP=kasama-computer-desktop
# DAYTONA_API_KEY=
# DAYTONA_SNAPSHOT_HEADLESS=kasama-computer-headless
# DAYTONA_SNAPSHOT_DESKTOP=kasama-computer-desktop
COMPUTER_TOKEN_SECRET=
EGRESS_CONTROL_TOKEN=
