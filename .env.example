# Copy to .env. Values for local development come from `supabase status`.
MODE=api
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# Postgres (local Supabase default)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# The worker's least-privilege role (casama_worker, D-095). Locally, supabase/seed.sql gives it this
# password. Unset, the worker uses DATABASE_URL, which local Supabase's postgres role can't run it with.
WORKER_DATABASE_URL=postgres://casama_worker:casama_worker_dev@127.0.0.1:54322/postgres

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Optional legacy HS256 secret; when empty, tokens are verified against the project's JWKS.
SUPABASE_JWT_SECRET=

PUBLIC_APP_URL=http://localhost:3000
# App connections (D-089): OAuth clients for apps without automatic sign-up, JSON by app id.
# MCP_OAUTH_CLIENTS={"slack":{"client_id":"...","client_secret":"..."}}
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Zoho Mail, CRM, Desk and Books with one sign-in (D-350): a Zoho "Server-based application" client
# from api-console.zoho.com, multi-DC on, redirect <API>/oauth/callback.
# ZOHO_OAUTH_CLIENT_ID=
# ZOHO_OAUTH_CLIENT_SECRET=
# Server-wide Google AI key, only for live calls, in workspaces without their own (you pay Google)
# GOOGLE_AI_API_KEY=
# Live calls: once the conversation passes the trigger (tokens; two-way talk is about 1500 a
# minute), its oldest turns are dropped down to the target. Gemini Live bills every turn for the
# whole call so far, so lower numbers make long calls cheaper and higher ones let the bot remember
# more of the call. Both at least 1000, target below trigger.
# VOICE_CONTEXT_TRIGGER_TOKENS=8000
# VOICE_CONTEXT_TARGET_TOKENS=3000
# Where vendors send people back after an app sign-in. Default: <API>/oauth/callback, or localhost
# when the API is on a LAN address over http (vendors only accept https or localhost).
# OAUTH_REDIRECT_URL=http://localhost:8787/oauth/callback
# Casama Cloud abuse controls (D-094): auto = on when BILLING_ENABLED is on.
# ABUSE_CONTROLS=auto
# AUTH_HOOK_SECRET=v1,whsec_...
# APP_CHECK_PROJECT_NUMBER=
# ChatGPT plan sign-in (D-091): auto = on for self-hosted servers, off when BILLING_ENABLED is on.
# CHATGPT_SIGN_IN=auto
# Wallpaper photo search (optional, D-087). Unset: the app offers its own patterns and photos.
# UNSPLASH_ACCESS_KEY=
# Open gallery of themes, color schemes, wallpapers and skills (D-184). Set to off to turn it off.
# GALLERY_URL=https://gallery.casama.ai
# Signed gallery (D-315): required | optional | off, and the catalog's public key (empty = Casama's key
# for the default GALLERY_URL). More catalogs: name=url or name=url#<base64 public key>, comma-separated.
# GALLERY_SIGNATURE=optional
# GALLERY_PUBLIC_KEY=
# GALLERY_SOURCES=team=https://gallery.example.com
# Use counts shown on gallery items come from Casama's public stats; off hides them.
# GALLERY_STATS_URL=https://api.casama.ai/v1/gallery/stats
# Submissions from the app open pull requests on this repository (needs a GitHub token).
# GALLERY_SUBMIT_REPO=stackwares/casama-gallery
# GALLERY_SUBMIT_TOKEN=
# Contributor rewards in credits by active users (billing on only), or off.
# GALLERY_REWARDS={"50":10,"250":25,"1000":75}
# Free web search for bots without a workspace search key: a SearXNG instance (D-179)
# SEARXNG_URL=http://localhost:18080
# The server's own web search for workspaces without a key, tried in this order before SearXNG
# (D-384). A provider without its key is skipped. DeepSeek only when named here: queries go to
# DeepSeek's servers. Parallel and Serper are $1 per 1,000 queries, DeepSeek $0.75.
# SEARCH_PROVIDER_ORDER=parallel,serper,searxng
# PARALLEL_API_KEY=
# SERPER_API_KEY=
# DEEPSEEK_SEARCH_API_KEY=
# Billing (Casama Cloud only, D-070). Self-hosted servers keep it off: no paywall, no limits.
BILLING_ENABLED=false
# DODO_API_KEY=
# DODO_WEBHOOK_SECRET=
# DODO_ENVIRONMENT=test
# App Store and Google Play through RevenueCat (D-297): a read-only v2 secret key, and the webhook's
# Authorization value and signing secret from RevenueCat's dashboard.
# REVENUECAT_PROJECT_ID=
# REVENUECAT_API_KEY=
# REVENUECAT_WEBHOOK_AUTH=
# REVENUECAT_WEBHOOK_SIGNING_SECRET=
# Casama Link, cloud side (D-071): forwarded to SUPERVISOR_URL and this model upstream.
# The same key is Casama Cloud's shared model (D-186): a workspace with no key of its own runs on it,
# paid from credits (OpenRouter cost × 1.055 × 1.3). The welcome chat skips the "add a key" card.
# It also covers images, video, read-aloud and dictation for those workspaces (D-261).
# CLOUD_MODEL_MARKUP is only the Casama Link proxy, for self-hosted servers buying model credits.
# CLOUD_MODEL_UPSTREAM_URL=https://openrouter.ai/api/v1
# CLOUD_MODEL_UPSTREAM_KEY=
# CLOUD_MODEL_MARKUP=1
# Which OpenRouter providers serve that key (D-354). A model is sold by many providers at prices
# several times apart, each with its own prompt cache. price (default) tries the cheapest first;
# throughput and latency rank by speed; off leaves OpenRouter's spread across providers.
# CLOUD_MODEL_PROVIDERS names providers to try before the rest, in order (OpenRouter provider tags).
# CLOUD_MODEL_PROVIDER_SORT=price
# CLOUD_MODEL_PROVIDERS=
# A different sort for chats a person is waiting on (D-355): throughput answers about 2.4 times
# faster at about 3 times the price. Routines, check-ins and background work keep the sort above.
# CLOUD_MODEL_CHAT_SORT=
# CLOUD_COMPUTER_USD_PER_HOUR=0.05
# Casama Link, self-hosted side: run computers on Casama Cloud with a Casama Link key.
# CASAMA_CLOUD_URL=
# CASAMA_CLOUD_KEY=
RATE_LIMIT_PER_MINUTE=120

# Email (optional). Without it, invite tokens are returned to the inviter.
# Push notifications (worker): Firebase service account JSON, inline or a path to the file.
# The apps must be built with the same Firebase project (client/config/firebase.json).
FCM_SERVICE_ACCOUNT=
# That project's number (sender id), for Casama for Chrome's pushes.
FCM_SENDER_ID=
# Encryption at rest (workspaces turn it on in settings): a 32-byte base64 key that wraps workspace keys
# (openssl rand -base64 32). During a rotation, put the old key in CONTENT_ENCRYPTION_KEY_PREVIOUS.
CONTENT_ENCRYPTION_KEY=
# CONTENT_ENCRYPTION_KEY_PREVIOUS=
# Or AWS KMS instead: CONTENT_KMS_KEY_ID, CONTENT_KMS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# Sign-up allowlist: only these emails or domains can sign up (e.g. "ana@example.com,@acme.com").
# Needs the sign-up hook: SIGNUP_HOOK_ENABLED=true and AUTH_HOOK_SECRET=v1,whsec_<base64> (openssl rand -base64 32).
# SIGNUP_ALLOWED_EMAILS=
# SIGNUP_HOOK_ENABLED=false
# AUTH_HOOK_SECRET=
# Cloudflare AI Gateway for model calls (caching, logs, rate limits): https://gateway.ai.cloudflare.com/v1/<account>/<gateway>
# AI_GATEWAY_URL=
# AI_GATEWAY_TOKEN=
# Live data cards (D-458): weather, prices, rates and more as cards. On with no keys.
# LIVE_DATA=on
# Open-Meteo's free API is non-commercial: auto uses it only when BILLING_ENABLED is off.
# LIVE_OPEN_METEO=auto
# LIVE_OPEN_METEO_KEY=
# Yahoo Finance and ESPN (no published API terms): auto uses them only when BILLING_ENABLED is off.
# LIVE_UNOFFICIAL=auto
# LIVE_COINGECKO_KEY=
# Stocks on servers that bill people (Finnhub):
# LIVE_FINNHUB_KEY=
# Flight status, parcel tracking, film details (their tools appear only with a key):
# LIVE_AVIATIONSTACK_KEY=
# LIVE_17TRACK_KEY=
# LIVE_TMDB_KEY=
# Flight fares (live.fares): Kiwi.com's free MCP server, then Google Flights through SerpApi.
# Keep the monthly cap under your SerpApi plan (free plan: 250). Billing servers charge each Google
# search that finds fares in credits; Kiwi searches are free.
# LIVE_FARES=auto
# LIVE_FARES_ORDER=kiwi,serpapi
# LIVE_KIWI_MCP_URL=https://mcp.kiwi.com
# LIVE_SERPAPI_KEY=
# LIVE_SERPAPI_MONTHLY_CAP=225
# LIVE_SERPAPI_COST_USD=0.025
# LIVE_FARES_GOOGLE_PRICE_USD=0.05
# Affiliate booking links: an https link with {url} where the booking page goes (URL-encoded). Only
# links on the hosts below are wrapped, and Fares cards then say Casama may earn a commission.
# LIVE_FARES_AFFILIATE_URL=
# LIVE_FARES_AFFILIATE_HOSTS=kiwi.com
# "Compare on Aviasales" link under Fares cards: an https link with {url} where the Aviasales search
# page goes (URL-encoded), e.g. https://tp.media/r?marker=<yours>&trs=<project>&p=4114&u={url}
# LIVE_FARES_COMPARE_URL=
# Paid data resale (Casama Cloud only, after a written agreement with Treg). Self-hosters add their own Treg key in Model keys.
# TREG_API_KEY=
# TREG_RESALE=off
# iOS call rings through PushKit (phone-call voice) and iPhone/Mac widget refresh pushes (D-405):
# APNs token key (.p8 contents or a path), key id, team id
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
# APNS_VOIP_TOPIC=ai.casama.app.voip
# APNS_TOPIC_APP=ai.casama.app
# Sign in with Apple token revocation when an account is deleted (D-420, App Store 5.1.1(v)):
# the Sign in with Apple key (.p8 contents or a path), its key id and the team id.
# APPLE_SIGNIN_KEY_P8=
# APPLE_SIGNIN_KEY_ID=
# APPLE_SIGNIN_TEAM_ID=
# APPLE_SIGNIN_APP_ID=ai.casama.app
# APPLE_SIGNIN_SERVICES_ID=ai.casama.app.signin
RESEND_API_KEY=
EMAIL_FROM=Casama <no-reply@localhost>
# Casama Cloud only (D-408): the app's "Casama's monthly email" switch, through Resend. Leave unset
# on a self-hosted server (the switch stays hidden). The webhook secret is for /hooks/newsletter/resend.
# NEWSLETTER_RESEND_API_KEY=
# NEWSLETTER_WEBHOOK_SECRET=
# Or send through any SMTP server (used when RESEND_API_KEY is empty). Port 465 = TLS, others STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Hosted bot mail (BOT-EMAIL-PLAN §9): the domain bot addresses live on. Unset: no hosted
# addresses (the bring-your-own email chat app still works). MAIL_HOOK_SECRET is shared with the
# mail Worker; MAIL_SENDER picks cloudflare (Email Sending) or resend as the fallback.
# MAIL_DOMAIN=
# MAIL_HOOK_SECRET=
# MAIL_SENDER=cloudflare
# MAIL_CF_ACCOUNT_ID=
# MAIL_CF_API_TOKEN=
# MAIL_RESEND_API_KEY=
# MAIL_SEND_PAUSED=false
# Most hosted mails all workspaces send in a day (default 900 with Cloudflare; 0 = none).
# MAIL_SEND_DAILY_MAX=

# Observability (optional)
# Error reporting (D-063), off unless a key is set: auto | sentry | posthog | none
ERROR_REPORTING=auto
# Sentry protocol: sentry.io, self-hosted Sentry or GlitchTip
SENTRY_DSN=
# PostHog (cloud region or self-hosted)
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# Product analytics environment tag (production | staging | development; defaults to NODE_ENV)
# ANALYTICS_ENVIRONMENT=production
# Product analytics on server (off by default): false | true
PRODUCT_ANALYTICS=off
# Which providers get product events: posthog | ga4 | posthog,ga4 | none (unset = every provider with keys)
# ANALYTICS_PROVIDERS=posthog,ga4
# Comma-separated emails or email domains to mark as internal/test accounts (is_internal / traffic_type=internal)
# INTERNAL_EMAILS=
# INTERNAL_EMAIL_DOMAINS=
# Google Analytics 4 (free): a web data stream's measurement id and a Measurement Protocol API secret
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_API_SECRET=
# Erase purged accounts from GA4: numeric property id + service account JSON with Editor on the property
# GA4_PROPERTY_ID=
# GA4_SERVICE_ACCOUNT_JSON=
# Casama Cloud only: erase a purged account's PostHog person (personal API key with person write scope).
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=
# POSTHOG_APP_HOST=https://us.posthog.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# Worker
RUN_CONCURRENCY=20
# Runs one workspace may have going at once; the rest wait (0 = no limit)
RUN_WORKSPACE_CONCURRENCY=5
# auto = embed memories with the org's OpenAI key when present; none = full-text only
EMBEDDINGS=auto
# Replay recorded model responses instead of calling providers (tests, demos)
CASAMA_MODEL_FIXTURES=
# Record real model exchanges as fixture turns (JSON lines)
CASAMA_MODEL_RECORD=

# Integrations (Phase 4, optional until configured)
# COMPOSIO_API_KEY=
# PIPEDREAM_CLIENT_ID=
# PIPEDREAM_CLIENT_SECRET=
# PIPEDREAM_PROJECT_ID=
# PIPEDREAM_ENVIRONMENT=development

# Computers (sandbox supervisor and egress proxy). Generate each with: openssl rand -hex 24
SUPERVISOR_URL=http://localhost:8788
SUPERVISOR_TOKEN=

# Live view (Phase 5): coturn's shared secret and the TURN address viewers use.
TURN_SECRET=
TURN_PUBLIC_HOST=localhost
TURN_PORT=3478
# TURN_TLS_PORT=5349
# PUBLIC_API_URL=https://api.example.com
# Pages (D-119) are served from their own origin. PAGES_PORT serves it from the API process.
# PAGES_URL=https://pages.example.com
# PAGES_PORT=8790
# Sites (D-329): pages put on the web at <name>.<zone>, served by the pages port by host name.
# Point *.<zone> and <zone> at the pages port. Unset: sites are off.
# CASAMA_SITES_ZONE=sites.example.com
# Connected domains: your own Caddy with on-demand TLS, or Cloudflare for SaaS on the zone.
# CASAMA_SITES_OWN_EDGE=false
# CASAMA_SITES_CF_ZONE_ID=
# CASAMA_SITES_CF_API_TOKEN=
# CASAMA_SITES_SERVER_IPV4=
# CASAMA_SITES_SERVER_IPV6=
# CASAMA_SITES_APEX=forward
# Buying domains (Casama Cloud): the registrar and the Dodo products for domain payments.
# CASAMA_DOMAINS_REGISTRAR=none
# The endings on sale when Admin console > Pricing > Cost tables has no saved list (D-373).
# CASAMA_DOMAINS_TLDS=com,net,org,co,io,app,dev,xyz,me,info
# NAMECOM_USERNAME=
# NAMECOM_API_TOKEN=
# NAMECOM_API_URL=https://api.name.com  (https://api.dev.name.com for Name.com's test system)
# NAMECOM_WEBHOOK_SECRET=
# DODO_DOMAIN_PRODUCT_ID=          (the "Domain" Pay What You Want product)
# DODO_DOMAIN_RENEWAL_PRODUCT_ID=  (the "Domains renewal" on-demand subscription product)
# Instance owners get a notice when the registrar's prepaid balance is under this (USD).
# CASAMA_DOMAINS_BALANCE_ALERT=100
# Headless Chromium for page PDF export (unset: PDF export is off).
# PDF_CHROMIUM_PATH=/usr/bin/chromium

# Hosted computers (optional, supervisor): E2B and Daytona run the same computer image.
# E2B_API_KEY=
# E2B_TEMPLATE_HEADLESS=casama-computer-headless
# E2B_TEMPLATE_DESKTOP=casama-computer-desktop
# DAYTONA_API_KEY=
# DAYTONA_SNAPSHOT_HEADLESS=casama-computer-headless
# DAYTONA_SNAPSHOT_DESKTOP=casama-computer-desktop
# More hosted providers (D-139). Image-based ones run HOSTED_IMAGE_HEADLESS / HOSTED_IMAGE_DESKTOP.
# NOVITA_API_KEY=                      (E2B-compatible; templates like E2B)
# K8S_NAMESPACE=casama-computers       (in-cluster service account, or K8S_API_URL + K8S_TOKEN + K8S_CA_FILE)
# INCUS_URL=https://incus:8443         (INCUS_TOKEN, or INCUS_CLIENT_CERT_FILE + INCUS_CLIENT_KEY_FILE; INCUS_REGISTRY)
# BOAT_API_KEY=
# RAILWAY_TOKEN=  RAILWAY_PROJECT_ID=  RAILWAY_ENVIRONMENT_ID=  (RAILWAY_TOKEN_KIND=project for project tokens)
COMPUTER_TOKEN_SECRET=
EGRESS_CONTROL_TOKEN=

# Default model (D-064): DeepSeek V4.1 Flash 1017 on OpenRouter, GPT-6 Luna on OpenAI; medium reasoning effort unless overridden.
# DEFAULT_MODEL_OPENROUTER=deepseek/deepseek-v4.1-flash-1017
# DEFAULT_MODEL_OPENAI=gpt-6-luna
# DEFAULT_REASONING_EFFORT=medium
# Live checks (scripts/live-check.sh) read the real key from ~/.config/casama/openrouter.env,
# never from this file.

# Object storage for snapshots and checkpoints (supervisor, D-062). Default: filesystem volume.
# Library files (D-276) on a plain folder; without this or OBJECT_STORE=s3, library.save is unavailable.
# Compose sets it to /data/library. For `pnpm dev`, use an absolute path, e.g. <repo>/.data/library
# OBJECT_STORE_DIR=
# Self-hosted S3: `docker compose --profile s3 up`, then:
# OBJECT_STORE=s3
# S3_ENDPOINT=http://casama-s3:8333
# S3_BUCKET=casama
# S3_CREATE_BUCKET=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Hosted (recommended: Cloudflare R2, no egress fees):
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto

# Desktop companion (D-066): users' own machines as bot computers. On by default.
# LOCAL_COMPUTERS=true
# How the worker reaches the API's internal tunnel (default http://127.0.0.1:$PORT)
# API_INTERNAL_URL=http://api:8787

# Owner admin console (D-068): comma-separated owner emails; default: the first user to sign up.
# INSTANCE_ADMIN_EMAILS=you@example.com
# Update notices (off unless set), e.g. https://api.github.com/repos/stackwares/casama/releases/latest
# UPDATE_CHECK_URL=

# Phase 8 (D-072..D-078)
# Days between an account deletion request and the purge (0-30).
ACCOUNT_DELETION_GRACE_DAYS=7
# Opt-in anonymous telemetry: weekly instance id, version and two counts. Off by default.
TELEMETRY=off
# Bearer token for /metrics (Prometheus); without it /metrics is off in production.
METRICS_TOKEN=
# Enterprise features (ee/): license key and the Supabase service role key for SSO.
CASAMA_LICENSE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Admin > Vendors monitoring. Keep real values in your secret store.
# Reuse an existing authorized management key; readers perform only usage/balance requests.
# VENDOR_OPENROUTER_MANAGEMENT_KEY=
# VENDOR_TWILIO_ACCOUNT_SID=
# VENDOR_TWILIO_AUTH_TOKEN=
# VENDOR_CLOUDFLARE_ACCOUNT_ID=
# VENDOR_CLOUDFLARE_BILLING_TOKEN=
# VENDOR_COMPOSIO_ORG_KEY=
# GOOGLE_USAGE_SA_JSON=
# GOOGLE_USAGE_TILE_METHOD=maps_api.tas.TileService.GetTileMedia
# VENDOR_HERE_KEY_ID=
# VENDOR_HERE_KEY_SECRET=
# VENDOR_HERE_REALM=
# VENDOR_HERE_FEATURE_ID=
# MapTiler tokens grant full account access. Supply only an explicitly authorized existing token.
# VENDOR_MAPTILER_SERVICE_TOKEN=
# Alert recipients; falls back to INSTANCE_ADMIN_EMAILS, then the first account.
# VENDOR_ALERT_EMAILS=
