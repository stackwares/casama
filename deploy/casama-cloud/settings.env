# Casama Cloud's non-secret settings (D-197). Applied on top of the generated .env with
#   ./install.sh --pull --behind-proxy --domain api.casama.ai --turn-host turn.casama.ai \
#     --search --backups --settings deploy/casama-cloud/settings.env
# Secrets (keys, passwords, tokens) never go in this file: put them in infra/compose/.env on the
# server, from Vaultwarden. deploy/casama-cloud/README.md lists them.

# Instance admins: abuse alerts, suspensions, the owner console.
INSTANCE_ADMIN_EMAILS=admin@casama.ai

# Abuse controls (D-094): sign-up hook with App Check or proof of work, egress abuse reports.
ABUSE_CONTROLS=on
SIGNUP_HOOK_ENABLED=true
SIGNUP_PROOFS=app_check,pow
APP_CHECK_PROJECT_NUMBER=278631205206
EGRESS_ABUSE=on
# New accounts confirm their email (D-183).
EMAIL_AUTOCONFIRM=false

# Plans and payments (Phase 7) and Cloud Connect.
BILLING_ENABLED=true
CLOUD_CONNECT=true

# App connections redirect here (D-166).
OAUTH_REDIRECT_URL=https://api.casama.ai/oauth/callback

# Mail from the Casama domain (D-174); SMTP_USER and SMTP_PASS come from Vaultwarden.
EMAIL_FROM=Casama <hello@casama.ai>
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587

# Daily off-site backups (D-197) to R2, encrypted to the "Casama Cloud backups" age key
# (private half only in Vaultwarden). BACKUP_S3_ACCESS_KEY_ID and BACKUP_S3_SECRET_ACCESS_KEY
# come from Vaultwarden ("Cloudflare R2 · casama-backups").
BACKUP_S3_BUCKET=casama-backups
BACKUP_S3_ENDPOINT=https://0e39b3b828e0c3f87f8f45fa626fa720.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=casama-cloud
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14
BACKUP_OBJECTS=true
BACKUP_AGE_RECIPIENTS=age1ch9mg0rdchfedwjm24tn4rzhrnda9ertpwsvfuqrqz5gxkkxty3qap453g

# This server receives telemetry pings; it doesn't send any.
TELEMETRY=off
